{
  "manifest_version": 3,
  "name": "EKO Browser Bridge",
  "version": "0.1.0",
  "description": "Connect explicitly authorized Chrome tabs to the local EKO desktop app.",
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabGroups",
    "tabs"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "optional_permissions": ["debugger"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "EKO Browser Bridge",
    "default_popup": "popup.html"
  }
}
