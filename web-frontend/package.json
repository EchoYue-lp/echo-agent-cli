{
  "name": "web-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:tauri": "vite --mode tauri",
    "lint": "eslint . --max-warnings 0",
    "test": "npm run lint && npm run test:unit",
    "test:unit": "vitest run",
