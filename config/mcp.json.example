{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-playwright"],
      "disabled": false,
      "description": "Playwright MCP Server - browser automation via MCP"
    },
    "browser": {
      "command": "./agent-browser/mcp/target/release/agent-browser-mcp",
      "args": [],
      "disabled": false
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@anthropic-ai/mcp-server-filesystem", "/workspace"],
      "disabled": true
    }
  }
}
