{
  "$schema": "https://raw.githubusercontent.com/nickel-lang/json-schema-store/main/tauri.v2.schema.json",
  "productName": "EchoCoWork",
  "version": "1.0.0",
  "identifier": "com.echocowork.desktop",
  "mainBinaryName": "echo-agent-tauri",
  "build": {
    "beforeDevCommand": "cd ../web-frontend && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "cd ../web-frontend && npm run build",
    "frontendDist": "web-frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "EchoCoWork",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "src-tauri/icons/32x32.png",
      "src-tauri/icons/128x128.png",
      "src-tauri/icons/128x128@2x.png",
      "src-tauri/icons/icon.icns",
      "src-tauri/icons/icon.ico"
    ]
  }
}
